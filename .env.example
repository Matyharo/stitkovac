# Štítkovač - Konfigurace prostředí (Environment Variables)

# Databázové spojení (SQLite file path)
DATABASE_URL="file:./dev.db"

# Bezpečnost a Autentizace (Basic Auth / Session secret)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=""
SESSION_SECRET=super-secret-session-key-change-in-production

# Shoptet API & Live Feed Integrace (Volitelné)
SHOPTET_API_KEY=your_shoptet_api_key_here
SHOPTET_ESHOP_ID=your_eshop_id_here
SHOPTET_FEED_URL="https://www.vas-eshop.cz/export/products.xls?patternId=1&hash=vas_tajny_hash"

# Lokální AI Asistent pro výběr bezpečnostních textů (Ollama)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:4b-instruct"

# Povolte false pouze pri pristupu pres HTTP v duveryhodne mistni siti.
# Pri HTTPS ponechte true. SESSION_SECRET musi byt nahodny (alespon 32 znaku).
SESSION_COOKIE_SECURE=true

# Feed smí stahovat jen tyto veřejné HTTPS domény.
FEED_ALLOWED_HOSTS=depilujeme.cz,www.depilujeme.cz
# Volitelný připojený disk pro druhou kopii záloh:
# OFFSITE_BACKUP_DIRECTORY=/mnt/backup/stitkovac
