datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  brand       String?
  price       Float?
  safetyText  String?
  contactText String?
  ean         String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LabelTemplate {
  id           String   @id @default(uuid())
  name         String
  fieldsConfig String   // JSON: visibilities of name, price, sku, ean, safetyText, contactText, brand
  fontConfig   String   // JSON: font sizes (title, text, safety, price) and styling
  layoutConfig String   // JSON: topMargin, leftMargin, horizontalGap, verticalGap, labelWidth, labelHeight (in mm)
  sortOrder    Int      @default(0)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PrintJob {
  id            String   @id @default(uuid())
  products      String   // JSON: array of { productId, name, sku, price, quantity }
  startPosition Int      // 1 to 21
  createdAt     DateTime @default(now())
}

model ContactRule {
  id           String   @id @default(uuid())
  brandPattern String   // Text for matching brand. Empty for the default rule.
  companyName  String
  ico          String
  address      String
  website      String
  safetyText   String?  // Výchozí nebo značkově specifický bezpečnostní text
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("user") // "admin" | "user"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  username  String   // Uživatelské jméno osoby, která akci provedla
  action    String   // Např. "LOGIN", "PRODUCT_CREATE", "PRODUCT_UPDATE", "PRODUCT_DELETE", "PRINT_JOB_CREATE", "TEMPLATE_SAVE"
  details   String   // Podrobnosti o změně
  createdAt DateTime @default(now())
}

model FeedConfig {
  id                    String    @id @default(uuid())
  url                   String    @default("https://www.depilujeme.cz/export/products.xls?patternId=177&stripTags=1&partnerId=8&hash=bd7ec2786770a3a07fbc0289e88b5bd42a24c36accfad326881f45d72ecbc724")
  autoApplySafe         Boolean   @default(true)
  priceThresholdPercent Float     @default(30.0)
  checkEanValidity      Boolean   @default(true)
  cronSecret            String    @default("shoptet-feed-sync-secret")
  lastSyncAt            DateTime?
  syncStatus            String?   // "success" | "error" | "running" | "idle"
  syncMessage           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model PendingProductApproval {
  id             String   @id @default(uuid())
  sku            String   @unique
  name           String
  brand          String?
  price          Float?
  ean            String?
  safetyText     String?
  contactText    String?
  note           String?
  oldData        String?  // JSON stávajícího stavu produktu v DB (pokud existoval)
  changes        String?  // JSON zjištěných změn (pole, původní hodnota, nová hodnota)
  warningType    String   // "price_jump" | "name_change" | "invalid_ean" | "manual_review" | "new_product"
  warningMessage String
  status         String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SyncLog {
  id            String   @id @default(uuid())
  status        String   // "success" | "error" | "warning"
  totalFetched  Int      @default(0)
  autoCreated   Int      @default(0)
  autoUpdated   Int      @default(0)
  pendingReview Int      @default(0)
  unchanged     Int      @default(0)
  errorMessage  String?
  durationMs    Int      @default(0)
  createdAt     DateTime @default(now())
}


